{
  "name": "promptconduit",
  "displayName": "PromptConduit",
  "description": "See where every AI prompt's money goes. The Loop shows each round-trip to the model, what it re-read, which tools ran, what would have been cheaper, and how it compares with your past runs. Live cost in the status bar. 100% local. Claude Code and Cursor.",
  "version": "0.26.0",
  "publisher": "promptconduit",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#14181d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "cursor",
    "agent",
    "ai cost",
    "token",
    "cost",
    "usage",
    "prompt caching",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promptconduit/editor-extension.git"
  },
  "bugs": {
    "url": "https://github.com/promptconduit/editor-extension/issues"
  },
  "homepage": "https://github.com/promptconduit/editor-extension#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptconduit.cost.showDetails",
        "title": "PromptConduit: Show The Loop"
      },
      {
        "command": "promptconduit.cost.pinSession",
        "title": "PromptConduit: Pin Cost Session",
        "icon": "$(pin)"
      },
      {
        "command": "promptconduit.cost.followActive",
        "title": "PromptConduit: Follow Active Cost Session",
        "icon": "$(sync)"
      },
      {
        "command": "promptconduit.account.login",
        "title": "PromptConduit: Sign In"
      },
      {
        "command": "promptconduit.account.dismissLogin",
        "title": "PromptConduit: Dismiss Sign-In Prompt"
      },
      {
        "command": "promptconduit.agent.registerMcp",
        "title": "PromptConduit: Register MCP Server for Your Agent"
      },
      {
        "command": "promptconduit.agent.dismissHint",
        "title": "PromptConduit: Hide \"Ask Your Agent\" Hint"
      },
      {
        "command": "promptconduit.team.invite",
        "title": "PromptConduit: Invite a Teammate"
      },
      {
        "command": "promptconduit.feedback.send",
        "title": "PromptConduit: Send Feedback"
      },
      {
        "command": "promptconduit.setup.installCli",
        "title": "PromptConduit: Install the CLI"
      },
      {
        "command": "promptconduit.setup.runInit",
        "title": "PromptConduit: Run Setup (promptconduit init)"
      },
      {
        "command": "promptconduit.restore.sessions",
        "title": "PromptConduit: Restore AI Sessions"
      },
      {
        "command": "promptconduit.refreshPanel",
        "title": "PromptConduit: Refresh Panel",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "PromptConduit",
      "properties": {
        "promptconduit.cost.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the realtime token-cost item in the status bar."
        },
        "promptconduit.cost.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the promptconduit CLI (used by session restore). Leave blank to auto-detect on PATH and common install locations."
        },
        "promptconduit.restore.mode": {
          "type": "string",
          "enum": [
            "auto",
            "prompt",
            "off"
          ],
          "enumDescriptions": [
            "On startup, silently reopen interrupted Claude Code sessions in this workspace (a summary notification confirms what was restored).",
            "On startup, ask before reopening interrupted sessions.",
            "Never auto-restore. You can still run 'PromptConduit: Restore AI Sessions' manually."
          ],
          "default": "auto",
          "description": "Reopen Claude Code sessions that were interrupted when the editor restarted, in the exact directory they ran in (worktrees included). Sessions still running are never touched."
        },
        "promptconduit.restore.sinceHours": {
          "type": "number",
          "default": 12,
          "description": "How far back to look for interrupted sessions to restore, in hours."
        },
        "promptconduit.cursorTabs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Cursor only (best effort): follow the selected agent/chat tab by reading Cursor's local workspace state, so the status-bar cost and The Loop switch to that conversation. Self-disables if the state database is unreadable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/build-webview.mjs",
    "build:webview": "node scripts/build-webview.mjs",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "watch": "node scripts/build-webview.mjs --watch & tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "dev": "bash scripts/dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture": "bash scripts/capture-screenshots.sh",
    "refresh-screenshots": "npm run compile && PREVIEW_NO_OPEN=1 npm run preview && node scripts/refresh-screenshots-from-preview.mjs",
    "preview": "vite-node dev/preview.ts",
    "build:cli-loop": "node dev/build-cli-bundle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.6"
  }
}
